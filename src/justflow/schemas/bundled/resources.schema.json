            "title": "ResourceConfig",
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "config": {
                "$ref": "#/$defs/resource_memory_cache_config"
              },
              "provider": {
                "const": "memory_cache",
                "type": "string"
              }
            },
            "required": [],
            "title": "ResourceConfig",
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "config": {
                "$ref": "#/$defs/resource_postgresql_config"
              },
              "provider": {
                "const": "postgresql",
                "type": "string"
              }
            },
            "required": [
              "config"
            ],
            "title": "ResourceConfig",
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "config": {
                "$ref": "#/$defs/resource_redis_config"
              },
              "provider": {
                "const": "redis",
                "type": "string"
              }
            },
            "required": [
              "config"
            ],
            "title": "ResourceConfig",
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "config": {
                "$ref": "#/$defs/resource_s3_config"
              },
              "provider": {
                "const": "s3",
                "type": "string"
              }
            },
            "required": [
              "config"
            ],
            "title": "ResourceConfig",
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "config": {
                "$ref": "#/$defs/resource_s3_object_config"
              },
              "provider": {
                "const": "s3_object",
                "type": "string"
              }
            },
            "required": [
              "config"
            ],
            "title": "ResourceConfig",
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "config": {
                "$ref": "#/$defs/resource_static_config"
              },
              "provider": {
                "const": "static",
                "type": "string"
              }
            },
            "required": [],
            "title": "ResourceConfig",
            "type": "object"
          },
