{
  "version": "0.1.0",
  "common": {
    "JUSTFLOW_RUNTIME__PROFILE": "production",
    "JUSTFLOW_RUNTIME__SCOPE": "{\"tenant\":\"${TENANT_ID}\",\"application\":\"${APPLICATION_ID}\",\"environment\":\"${ENVIRONMENT_ID}\"}",
    "JUSTFLOW_TEMPORAL__ADDRESS": "${TEMPORAL_ENDPOINT}:7233",
    "JUSTFLOW_TEMPORAL__NAMESPACE": "${TEMPORAL_NAMESPACE}",
    "JUSTFLOW_TEMPORAL__CONNECTION": "{\"mode\":\"tls\",\"server_name\":\"${TEMPORAL_SERVER_NAME}\",\"root_ca_path\":\"${TEMPORAL_ROOT_CA_PATH}\"}",
    "JUSTFLOW_CATALOG__BACKEND": "s3",
    "JUSTFLOW_CATALOG__BUCKET": "${DEFINITION_BUCKET}",
    "JUSTFLOW_CATALOG__PREFIX": "${DEFINITION_PREFIX}",
    "JUSTFLOW_CATALOG__REGION": "${AWS_REGION}",
    "JUSTFLOW_CATALOG__EXPECTED_BUCKET_OWNER": "${AWS_ACCOUNT_ID}",
    "JUSTFLOW_CATALOG__SERVER_SIDE_ENCRYPTION": "aws:kms",
    "JUSTFLOW_CATALOG__KMS_KEY_ID": "${CATALOG_KMS_KEY_ARN}",
    "JUSTFLOW_CONFIGURATION__BACKEND": "aws",
    "JUSTFLOW_CONFIGURATION__BUCKET": "${CONFIGURATION_BUCKET}",
    "JUSTFLOW_CONFIGURATION__PREFIX": "${CONFIGURATION_PREFIX}",
    "JUSTFLOW_CONFIGURATION__TABLE_NAME": "${CONFIGURATION_TABLE}",
    "JUSTFLOW_CONFIGURATION__REVISION_INDEX_NAME": "${CONFIGURATION_REVISION_INDEX}",
    "JUSTFLOW_CONFIGURATION__ACTIVATION_INDEX_NAME": "${CONFIGURATION_ACTIVATION_INDEX}",
    "JUSTFLOW_CONFIGURATION__REGION": "${AWS_REGION}",
    "JUSTFLOW_CONFIGURATION__EXPECTED_BUCKET_OWNER": "${AWS_ACCOUNT_ID}",
    "JUSTFLOW_CONFIGURATION__SERVER_SIDE_ENCRYPTION": "aws:kms",
    "JUSTFLOW_CONFIGURATION__KMS_KEY_ID": "${CONFIGURATION_KMS_KEY_ARN}",
    "JUSTFLOW_DEPLOYMENT__NAME": "${APPLICATION_NAME}",
    "JUSTFLOW_DEPLOYMENT__BUILD_ID": "${WORKER_BUILD_ID}",
    "JUSTFLOW_DEPLOYMENT__ARTIFACT_DIGEST": "sha256:${APPLICATION_IMAGE_DIGEST}",
    "JUSTFLOW_DEPLOYMENT__PACKAGE_VERSION": "${JUSTFLOW_VERSION}",
    "JUSTFLOW_DEPLOYMENT__SOURCE_REVISION": "${SOURCE_REVISION}",
    "JUSTFLOW_SCHEDULES__TASK_QUEUE": "${SCHEDULE_TASK_QUEUE}",
    "JUSTFLOW_TEMPORAL__TASK_QUEUE": "${BUSINESS_TASK_QUEUE}"
  },
  "gateway": {
    "JUSTFLOW_OPERATIONS__ADMIN_PANEL_ENABLED": "true",
    "JUSTFLOW_OPERATIONS__INDEXED_SEARCH_ATTRIBUTES_ENABLED": "true",
    "HOST_APPLICATION_PUBLIC_ORIGIN": "https://${APPLICATION_DOMAIN}",
    "FORWARDED_ALLOW_IPS": "${ALB_SUBNET_CIDRS}"
  },
  "worker": {},
  "secret_injection": {
    "gateway": {
      "JUSTFLOW_TEMPORAL__CONNECTION__API_KEY": "${GATEWAY_TEMPORAL_TOKEN_SECRET_ARN}",
      "HOST_APPLICATION_CREDENTIALS": "${HOST_CREDENTIALS_SECRET_ARN}"
    },
    "worker": {
      "JUSTFLOW_TEMPORAL__CONNECTION__API_KEY": "${WORKER_TEMPORAL_TOKEN_SECRET_ARN}",
      "JUSTFLOW_RESOURCE_CONNECTIONS__POSTGRES_DSNS__application": "${APPLICATION_POSTGRES_DSN_SECRET_ARN}",
      "JUSTFLOW_RESOURCE_CONNECTIONS__REDIS_URLS__application": "${APPLICATION_REDIS_URL_SECRET_ARN}"
    }
  }
}
