{
  "name": "@justflow/admin",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dev": "vite",
    "format": "biome format --write src tests index.html vite.config.ts",
    "lint": "biome check src tests index.html vite.config.ts",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8"
  }
}
